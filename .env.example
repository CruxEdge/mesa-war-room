# Copy to .env.local for local development. Set the real values in Vercel → Settings → Environment Variables.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<supabase anon / publishable key>
OPENROUTER_API_KEY=<openrouter key>
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_FALLBACK=google/gemini-3.7-flash
SYNC_SECRET=<long random string, also stored in app.config as sync_secret>
CRON_SECRET=<long random string used by the Vercel cron>
GOOGLE_CLIENT_ID=<Google OAuth web client id>
GOOGLE_CLIENT_SECRET=<Google OAuth client secret>
SITE_URL=https://mesa-war-room-mesa-pers.vercel.app
# Optional daily sync from Nexus and a shared Drive folder
NEXUS_TOKEN=
GOOGLE_API_KEY=
DRIVE_FOLDER_ID=
